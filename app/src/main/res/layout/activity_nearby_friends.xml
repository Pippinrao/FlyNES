<?xml version="1.0" encoding="utf-8"?>
<com.flynes.emu.NearbyFixedPage
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearby_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fly_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nearby_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/fly_background"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/fly_on_surface"
        app:title="@string/nearby_title"
        app:titleTextAppearance="@style/TextAppearance.FlyNes.Nearby.PageTitle"
        app:titleTextColor="@color/fly_on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:text="@string/nearby_network_auto_hint"
        android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
        android:textColor="@color/fly_on_surface_muted" />

    <LinearLayout
        android:id="@+id/nearby_role_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/nearby_create_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_nearby_card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nearby_role_host"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
                android:textColor="@color/fly_primary" />
            <TextView
                android:id="@+id/nearby_entry_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nearby_action_create"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.PaneTitle"
                android:textColor="@color/fly_on_surface" />
            <TextView
                android:id="@+id/nearby_entry_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/nearby_role_host_hint"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
                android:textColor="@color/fly_on_surface_muted" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nearby_action_create"
                style="@style/Widget.FlyNes.Nearby.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="0dp"
                android:includeFontPadding="false"
                android:text="@string/nearby_action_create" />
        </LinearLayout>

        <Space android:layout_width="16dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/nearby_scan_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_nearby_card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nearby_role_guest"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
                android:textColor="@color/fly_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nearby_action_scanQr"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.PaneTitle"
                android:textColor="@color/fly_on_surface" />
            <TextView
                android:id="@+id/nearby_scan_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/nearby_role_guest_hint"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
                android:textColor="@color/fly_on_surface_muted" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nearby_action_scan_qr"
                style="@style/Widget.FlyNes.Nearby.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="0dp"
                android:includeFontPadding="false"
                android:text="@string/nearby_action_scanQr" />
            <TextView
                android:id="@+id/nearby_scan_denied_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nearby_reason_permission_cameraDenied"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
                android:textColor="@color/fly_on_surface_muted"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.flynes.emu.NearbyFixedPage>
