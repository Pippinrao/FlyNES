<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearby_lobby_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fly_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nearby_lobby_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/fly_background"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/fly_on_surface"
        app:title="@string/nearby_lobby_title"
        app:titleTextAppearance="@style/TextAppearance.FlyNes.Nearby.PageTitle"
        app:titleTextColor="@color/fly_on_surface" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="16dp">
        <LinearLayout
            android:id="@+id/nearby_lobby_rows"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".42"
            android:orientation="vertical"
            android:gravity="center_vertical" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".58"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_nearby_card">
            <LinearLayout
                android:id="@+id/nearby_lobby_game_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/nearby_lobby_confirm_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="@string/nearby_blocked_session_read"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
                android:textColor="@color/fly_on_surface_muted"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
